{
  "extends": "./tsconfig.shared.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@main/*": ["src/main/*"],
      "@renderer/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      "@components/*": ["src/renderer/components/*"],
      "@features/*": ["src/renderer/features/*"],
      "@services/*": ["src/renderer/services/*"],
      "@store": ["src/renderer/store"],
      "@store/*": ["src/renderer/store/*"],
      "@hooks/*": ["src/renderer/hooks/*"],
      "@utils/*": ["src/renderer/utils/*"],
      "@app-types/*": ["src/renderer/types/*"]
    }
  },
  "include": ["src/**/*", "src/renderer/vite-env.d.ts","tests/**/*"],
  // src/main is compiled by tsconfig.main.json (module: CommonJS). It is excluded
  // here because main-process files legitimately use `import x = require(...)`,
  // which is invalid under this config's module: ESNext and would report TS1202.
  // tests/treeSitterTest.ts is a manual scratch script (not matched by vitest's
  // *.{test,spec,property}.ts globs) that imports src/main directly.
  "exclude": ["src/main/**/*", "tests/treeSitterTest.ts"],
}
