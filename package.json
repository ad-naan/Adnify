{
  "name": "adnify",
  "version": "1.7.60",
  "description": "Adnify - A lightweight yet powerful AI-powered code editor",
  "productName": "Adnify",
  "author": "adnaan <adnaan.worker@gmail.com>",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "^24.19.0",
    "pnpm": "9.15.9"
  },
  "homepage": "https://github.com/ad-naan/adnify",
  "repository": {
    "type": "git",
    "url": "https://github.com/ad-naan/adnify.git"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "preinstall": "node scripts/ensure-pnpm.js",
    "dev": "concurrently \"pnpm dev:main\" \"pnpm dev:renderer\"",
    "dev:main": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.main.json --noEmit --watch",
    "dev:renderer": "vite",
    "build": "vite build",
    "build:main": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc -p tsconfig.main.json --noEmit",
    "build:renderer": "vite build",
    "start": "electron .",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive:true, force:true}); require('fs').rmSync('release', {recursive:true, force:true})\"",
    "dist": "pnpm clean && pnpm build && electron-builder",
    "pack": "pnpm clean && pnpm build && electron-builder --dir",
    "preview": "pnpm build && electron .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --run --coverage",
    "assets:icons": "node scripts/generate-platform-icons.js",
    "changelog:sync": "node scripts/sync-changelog.js",
    "postinstall": "node scripts/postinstall.js",
    "rebuild": "npx electron-rebuild -f -w node-pty",
    "rebuild:all": "npx electron-rebuild -f -w"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "^1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "^2.1.4",
      "brace-expansion@>=4.0.0 <5.0.9": "^5.0.9",
      "fast-uri@>=3.0.0 <3.1.5": "^3.1.5",
      "hono@<4.12.34": "^4.12.34",
      "@hono/node-server@<2.0.5": "^2.0.5",
      "ip-address@<=10.3.0": "^10.3.1",
      "js-yaml@>=4.0.0 <4.3.1": "^4.3.1",
      "dompurify@<3.4.13": "^3.4.13",
      "sharp@<0.35.0": "^0.35.1",
      "tar@<7.5.22": "^7.5.22",
      "undici@<6.28.0": "^6.28.0",
      "protobufjs@<7.6.3": "^7.6.3"
    },
    "patchedDependencies": {
      "extract-zip@2.0.1": "patches/extract-zip@2.0.1.patch"
    }
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.23.0",
    "@parcel/watcher": "^2.4.1",
    "@vscode/ripgrep": "^1.15.9",
    "@xenova/transformers": "^2.17.2",
    "dugite": "^3.2.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "jszip": "^3.10.1",
    "node-pty": "^1.1.0",
    "p-limit": "^3.1.0",
    "pdf-parse": "1.1.1",
    "picomatch": "^4.0.4",
    "sharp": "^0.35.1",
    "ssh2": "^1.17.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/provider": "^4.0.7",
    "@ai-sdk/provider-utils": "^5.0.27",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^4.0.4",
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@monaco-editor/react": "^4.6.0",
    "@types/adm-zip": "^0.5.7",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/picomatch": "^4.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.9",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/addon-webgl": "^0.18.0",
    "@xterm/xterm": "^5.5.0",
    "adm-zip": "^0.6.0",
    "ai": "^7.0.66",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "diff": "^8.0.2",
    "dompurify": "^3.4.13",
    "electron": "^39.8.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "fast-check": "^4.4.0",
    "fast-json-stable-stringify": "^2.1.0",
    "framer-motion": "^12.25.0",
    "iconv-lite": "^0.6.3",
    "js-tiktoken": "^1.0.21",
    "katex": "^0.16.45",
    "lucide-react": "^0.562.0",
    "monaco-editor": "^0.55.1",
    "png2icons": "^2.0.1",
    "postcss": "^8.5.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^16.1.0",
    "react-virtuoso": "^4.18.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-language-server": "^5.1.3",
    "uri-js": "^4.4.1",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^4.1.9",
    "vscode-langservers-extracted": "^4.10.0",
    "yaml": "^2.8.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "build": {
    "appId": "com.adnify.app",
    "productName": "Adnify",
    "publish": {
      "provider": "github",
      "owner": "ad-naan",
      "repo": "adnify",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@vscode/ripgrep/**",
      "node_modules/dugite/**",
      "node_modules/@lancedb/**",
      "node_modules/@parcel/watcher/**",
      "node_modules/@parcel/watcher-*/**",
      "node_modules/sharp/**",
      "node_modules/ssh2/**",
      "node_modules/cpu-features/**"
    ],
    "files": [
      "dist/**/*",
      "public/**/*",
      "LICENSE",
      "NOTICE",
      "!**/*.map",
      "!**/node_modules/**/{CHANGELOG.md,README.md,README,readme.md,readme,CHANGELOG,ReleaseNotes}",
      "!**/node_modules/**/{test,__tests__,tests,powered-test,example,examples,docs,doc}",
      "!**/node_modules/**/*.d.ts",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!config.json",
      "!bootstrap.json",
      "!.adnify/**"
    ],
    "fileAssociations": [
      {
        "ext": "ts",
        "name": "TypeScript Source",
        "role": "Editor"
      },
      {
        "ext": "tsx",
        "name": "TypeScript React Source",
        "role": "Editor"
      },
      {
        "ext": "js",
        "name": "JavaScript Source",
        "role": "Editor"
      },
      {
        "ext": "jsx",
        "name": "JavaScript React Source",
        "role": "Editor"
      },
      {
        "ext": "java",
        "name": "Java Source",
        "role": "Editor"
      },
      {
        "ext": "md",
        "name": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": "json",
        "name": "JSON Document",
        "role": "Editor"
      }
    ],
    "win": {
      "icon": "public/brand/icons/app.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Adnify",
      "installerIcon": "public/brand/icons/app.ico",
      "uninstallerIcon": "public/brand/icons/app.ico",
      "installerHeaderIcon": "public/brand/icons/app.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "public/brand/icons/app.icns",
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "linux": {
      "icon": "public/brand/icons/app.png",
      "artifactName": "${productName}-${version}-${arch}-linux.${ext}",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    },
    "extraResources": [
      {
        "from": "resources/tree-sitter",
        "to": "tree-sitter"
      },
      {
        "from": "resources/uiux",
        "to": "uiux"
      },
      {
        "from": "resources/shell-integration",
        "to": "shell-integration"
      }
    ]
  },
  "optionalDependencies": {
    "@lancedb/lancedb-win32-x64-msvc": "^0.22.3"
  }
}
